# AIDSO Backend Production Environment Variables (Render API & Worker)

# Core Environment Setting (Must be 'production' on Render)
ENVIRONMENT=production

# Database Connection (Supabase / Render PostgreSQL / Neon)
# Note: Format must start with postgresql:// or postgres://
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# CORS Configuration (Only required on API Web Service)
# Comma-separated list of your frontend URLs without trailing slashes
CORS_ORIGINS=https://aidso-frontend.onrender.com

# AWS S3 Storage Credentials (Required for models, datasets, reports)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=eu-north-1
S3_BUCKET=aidso-prod-storage

# Optional LLM & Cache Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# REDIS_URL=redis://default:password@host:6379/0
# Docker execution broker (required for computation; see SANDBOXING.md)
AIDSO_SANDBOX_IMAGE=aidso-sandbox:local
AIDSO_SANDBOX_MEMORY_MB=1536
AIDSO_SANDBOX_CPUS=1
AIDSO_SANDBOX_CONCURRENCY=1
AIDSO_SANDBOX_TRAIN_TIMEOUT=900
AIDSO_SANDBOX_TIMEOUT=120

# Upload approval requires a real ClamAV daemon. Keep TCP 3310 private.
AIDSO_MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Local tests only can explicitly set AIDSO_MALWARE_SCANNER=development.
# This override is rejected when ENVIRONMENT is not local.

# Temporary operator-selected option while provisioning ClamAV:
# AIDSO_MALWARE_SCANNER=bypass
# Bypass skips malware scanning only, records it as skipped, and retains CSV/sandbox checks.
# Restore clamav and restart the API when the scanner is available.
