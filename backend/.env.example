# AIDSO Backend Production Environment Variables (Render API & Worker)

# Core Environment Setting (Must be 'production' on Render)
ENVIRONMENT=production

# Database Connection (Supabase / Render PostgreSQL / Neon)
# Note: Format must start with postgresql:// or postgres://
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# CORS Configuration (Only required on API Web Service)
# Comma-separated list of your frontend URLs without trailing slashes
CORS_ORIGINS=https://aidso-frontend.onrender.com

# AWS S3 Storage Credentials (Required for models, datasets, reports)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=eu-north-1
S3_BUCKET=aidso-prod-storage

# Optional LLM & Cache Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# REDIS_URL=redis://default:password@host:6379/0
